# =============================================================================
# WordPress best practice: track YOUR code + hosting config.
# Ignore core, third-party plugins/themes, media, caches, secrets, and junk.
# =============================================================================

# ----- Secrets & local config -----
wp-config.php
wp-config-local.php
.env
.env.*
!.env.example

# ----- Logs & backups -----
error_log
*.log
debug.log
*.bk
*.bak
*~

# ----- WordPress core (reinstallable via WP / host) -----
/wp-admin/
/wp-includes/
/wp-*.php
!/wp-config-sample.php
/xmlrpc.php
/license.txt
/readme.html
/readme.*
/index.php

# ----- Media (keep on server / separate backup) -----
/wp-content/uploads/

# ----- Caches, temp, security/plugin runtime -----
/wp-content/cache/
/wp-content/litespeed/
/wp-content/wflogs/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/aiowps_backups/
/wp-content/backups/
/wp-content/backup*/
/wp-content/temp/
/wp-content/tmp/

# ----- Translation packs (re-downloadable) -----
/wp-content/languages/

# ----- Themes: ignore stock; keep only custom/child themes -----
/wp-content/themes/*
!/wp-content/themes/index.php
!/wp-content/themes/trf-theme/

# ----- Must-use plugins: ignore third-party; keep site-specific -----
/wp-content/mu-plugins/*
!/wp-content/mu-plugins/index.php
!/wp-content/mu-plugins/trf-post-types.php

# ----- Plugins: ignore third-party; keep custom plugins only -----
/wp-content/plugins/*
!/wp-content/plugins/index.php
!/wp-content/plugins/trf-cargo-tracking/

# ----- Archives / dumps -----
*.sql
*.sql.gz
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# ----- Saved homepage dump (browser "Save page as") -----
/index.html
/index_files/

# ----- Host / ACME -----
.well-known/

# ----- OS / editor / build junk -----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.code-workspace
node_modules/
npm-debug.log*
yarn-error.log*
vendor/

# Docker local data (named volumes are preferred; ignore bind-mount data if added)
.env
